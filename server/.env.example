#========================================================================#
#                         SERVER CONFIGURATION                           #
#========================================================================#
# [OPTIONAL] The port the server will listen on. Defaults to 3000 if not specified.
PORT=3000
# [OPTIONAL] If you are using a VPS for deployment, uncomment the following line
#NODE_ENV=production

#========================================================================#
#                         DATABASE CONFIGURATION                         #
#========================================================================#
# [REQUIRED] MongoDB connection string. The README section "Database setup"
# walks through both ways of getting one — a hosted Atlas cluster, or a MongoDB
# you run yourself — including how to lock the self-hosted one down on a server.
#
#   Own MongoDB:  mongodb://127.0.0.1:27017/switchat_dev
#   With auth:    mongodb://<user>:<password>@127.0.0.1:27017/<database>
#   Atlas:        mongodb+srv://<user>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
#
# Development and production should never share a database. Pointing this at
# production means every test writes to real accounts, and it is one careless
# `deleteMany` away from being unrecoverable.
#
# If a deployed database is only reachable over SSH, forward it to a *different*
# local port than your own MongoDB — 27018 below — so both can be open at once
# and the port in the URI tells you which one you are about to write to:
#
#   ssh -N -L 27018:127.0.0.1:27017 <your-server>
#   MONGO_URI=mongodb://<user>:<password>@127.0.0.1:27018/<database>
#
# To develop against a copy of real data, restore a backup into the dev
# database (the ns flags rewrite the database name as it is restored):
#
#   mongorestore --uri="mongodb://127.0.0.1:27017" --archive=<backup>.gz --gzip \
#     --nsFrom='switchat.*' --nsTo='switchat_dev.*'
MONGO_URI=

#========================================================================#
#                          SECURITY CONFIGURATION                        #
#========================================================================#
# [REQUIRED] Secret key for signing JSON Web Tokens (JWT).
# Tip: You can generate a secure random string using: openssl rand -base64 32
JWT_SECRET=

# [REQUIRED] Key used to encrypt the API keys users sync to their account (AES-256-GCM).
# Must decode to exactly 32 bytes, and must NOT be the same value as JWT_SECRET:
# separate secrets for separate purposes, so leaking one does not compromise the other.
# Changing this makes every stored API key unreadable; users just re-enter them.
# Tip: openssl rand -base64 32
ENCRYPTION_KEY=

# [OPTIONAL] Comma-separated list of origins allowed to call the API from a browser.
# Defaults to http://localhost:5173, the Vite dev server.
#
# You normally do not need to touch this. The client calls the relative path `/api`, so the
# page and the API always share an origin: in development Vite proxies to Express, and in
# production Express serves the bundle itself. Nothing legitimate ever calls this API from
# another domain, and this list exists so nothing illegitimate can either.
#
# Set it only if you serve the client from a different domain than the API:
#   ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
#ALLOWED_ORIGINS=

#========================================================================#
#                            FEATURE FLAGS                               #
#========================================================================#
# [OPTIONAL] Enables or disables new account registration. Defaults to true.
# Set to "false" to close registration (existing users can still log in).
REGISTRATION_ENABLED=true
