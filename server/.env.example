#========================================================================#
#                         SERVER CONFIGURATION                           #
#========================================================================#
# The port the server will listen on. Defaults to 3000 if not specified.
PORT=3000
# If you are using a VPS for deployment, uncomment the following line
#NODE_ENV=production

#========================================================================#
#                         DATABASE CONFIGURATION                         #
#========================================================================#
# MongoDB connection string (Atlas or Local)
# Example: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGO_URI=

#========================================================================#
#                           API CONFIGURATION                            #
#========================================================================#
# API Key for Google Gemini (Google AI Studio)
GOOGLE_API_KEY=

# API Key for OpenAI
OPENAI_API_KEY=

# API Key for Anthropic Claude
ANTHROPIC_API_KEY=

#========================================================================#
#                          SECURITY CONFIGURATION                        #
#========================================================================#
# Secret key for signing JSON Web Tokens (JWT).
# Tip: You can generate a secure random string using: openssl rand -base64 32
JWT_SECRET=
